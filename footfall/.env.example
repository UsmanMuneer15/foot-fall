# FootFall API root (must include /api/footfall)
# Live:
NEXT_PUBLIC_API_URL=https://egc-appointment-apis-d4715c28cb17.herokuapp.com/api/footfall
# Local EG Concept:
# NEXT_PUBLIC_API_URL=http://localhost:3001/api/footfall

# Firebase (Google Sign-In) — copy values from Firebase Console into footfall/.env
# Do not commit real keys. NEXT_PUBLIC_* values are loaded at build/runtime from .env
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
